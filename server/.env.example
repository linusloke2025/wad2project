# Copy this file to `server/.env` and fill in real values.
# `server/.env` is gitignored — never commit real credentials. The repository is public.

# --- Session -----------------------------------------------------------------------------
# Signing key for JWT session tokens. Use a long random string anywhere shared or deployed.
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ----------------------------------------------------------------------------
# MongoDB Atlas connection string (free M0 tier).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- Server ------------------------------------------------------------------------------
PORT=3000

# --- OneMap (Singapore Land Authority) ---------------------------------------------------
# The Static Map API needs NO credentials. Verified against the live endpoint: the same request
# returns an identical 224KB PNG with and without a bearer token, so Map-layout rendering
# involves no secret at all.
#
# The values below are for the Route Service API, which the conflict engine uses to obtain real
# walking times for Map-layout events. Register at https://www.onemap.gov.sg/apidocs/register
#
# Do NOT paste a getToken access token here instead of credentials: those tokens are JWTs with a
# short lifetime (the one inspected expired after 3 days), so the app would break without warning.
# The server calls getToken itself and refreshes on the returned expiry_timestamp.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
