# Dependencies
node_modules/

# Workspace-local npm cache (created because the sandbox cannot write the global npm cache)
.npm-cache/

# Scratch / extraction workspace
.scratch/

# Environment
.env
.env.*
!.env.example

# Build + test output
dist/
coverage/
playwright-report/
test-results/
.vite/

# Playwright browsers, downloaded into the workspace because the sandbox blocks writing to
# %LOCALAPPDATA%. They are a ~115MB binary, not source.
.playwright-browsers/

# The embedded mongod used by the end-to-end suite, downloaded on first run.
.mongodb-binaries/

# School materials — not ours to publish in a public repo
Brief.pdf
docs/brief-decoded.txt

# OneMap credentials and saved docs — the repo is public, so these must never be committed.
# The pasted access token is a JWT that expires (3-day lifetime), so it also must not be
# relied on as a permanent key.
openmap.txt
Static Map*.html
.env
.env.local

# Generated by MongoDB Atlas onboarding and containing real database credentials. Its own
# header says not to commit it. The wildcard also catches similar files from other tools,
# because the safe direction for a credential-shaped filename is to over-match.
atlas-credentials.env
*credentials*.env
*secrets*.env

# Editor / OS
.DS_Store
Thumbs.db
*.log
